{
  "mcpServers": {
    "zotero": {
      "command": "${HOME}/.local/bin/zotero-mcp",
      "env": { "ZOTERO_LOCAL": "true" }
    },
    "computer-use-linux": {
      "command": "${HOME}/.cargo/bin/computer-use-linux",
      "args": ["mcp"]
    },
    "github-anira": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/?variant=anira",
      "headers": {
        "Authorization": "Bearer ${GITHUB_TOKEN_ANIRA}",
        "X-MCP-Toolsets": "context,repos,issues,pull_requests,users,actions"
      }
    },
    "github-tanh": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/?variant=tanh",
      "headers": {
        "Authorization": "Bearer ${GITHUB_TOKEN_TANH}",
        "X-MCP-Toolsets": "context,repos,issues,pull_requests,users,actions"
      }
    },
    "github-faressc": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/?variant=faressc",
      "headers": {
        "Authorization": "Bearer ${GITHUB_TOKEN_FARESSC}",
        "X-MCP-Toolsets": "context,repos,issues,pull_requests,users,actions"
      }
    }
  }
}
